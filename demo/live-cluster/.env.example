# jev-ops live-cluster demo — environment template.
# Copy to `.env` and export it, e.g.:
#   set -a; source .env; set +a
# The server reads variables from the environment only.

# HTTP port for the demo dashboard (default 8080)
#PORT=8080

# Inference provider: 'typesafe' (live TypeSafe Jev, default) or 'mock'
# (offline deterministic classifier — use it for rehearsals without a network
# and for the automated smoke test; never for the talk).
#JEVOPS_PROVIDER=typesafe

# TypeSafe Jev API key. Required to run live analyses (jev-ops exits 5 without it).
# The server starts without it but /api/analyze returns a clear error.
TYPESAFE_API_KEY=

# Path to the jev-ops binary (default: `jev-ops` on PATH).
# Install the prebuilt v2026.09.19 binary, e.g.:
#   curl -fsSL -o ~/.local/bin/jev-ops \
#     https://github.com/nemke82/jev-ops/releases/download/v2026.09.19/jev-ops-macos-arm64 && \
#   chmod +x ~/.local/bin/jev-ops
#JEVOPS_BIN=jev-ops

# Directory containing diagnostic packs. Defaults to <repo>/demo/live-cluster/packs.
#JEVOPS_PACK_DIR=

# External cluster support (talk day): point at a cloud cluster without touching
# ~/.kube/config. Both optional; empty means kubectl's current context.
#K8S_KUBECONFIG=
#K8S_CONTEXT=

# Which deployment/pods the demo watches.
#K8S_NAMESPACE=default
#K8S_DEPLOYMENT=demo-app
#K8S_POD_SELECTOR=app=demo-app

# Kubernetes warning events older than this many minutes are dropped from the
# diagnostic input (so a recovered fault doesn't contaminate the next analysis).
#K8S_EVENTS_WINDOW=5

# Port the demo app listens on inside its container (kubectl exec target).
#DEMO_APP_PORT=3000

# How many log lines to feed each analysis.
#ANALYZE_TAIL=100

# Autopilot — closed-loop remediation (all optional, safe defaults).
# Armed, the server re-runs the analysis every AUTOPILOT_INTERVAL_MS and acts
# on the kubernetes pack's typed decisions: needs_attention + severity >=
# AUTOPILOT_MIN_SEVERITY + confidence >= AUTOPILOT_MIN_CONFIDENCE + root_cause
# in {crashloop, resources} -> delete (restart) the failing pods, at most
# AUTOPILOT_MAX_ATTEMPTS times per incident, then it escalates to the
# dashboard feed (and Slack, if configured). Disarmed = analysis only.
# The dashboard can arm/disarm it live (POST /api/autopilot).
#AUTOPILOT_ARMED=false
#AUTOPILOT_INTERVAL_MS=15000
#AUTOPILOT_MIN_CONFIDENCE=0.85
#AUTOPILOT_MIN_SEVERITY=4
#AUTOPILOT_MAX_ATTEMPTS=1

# Optional Slack incoming webhook for escalation alerts (3 s timeout; failures
# land in the dashboard feed — the demo works fine without it).
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...